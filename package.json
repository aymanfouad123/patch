{
  "name": "patch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @patch/web dev",
    "build": "pnpm --filter @patch/web build",
    "start": "pnpm --filter @patch/web start",
    "convex:dev": "convex dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p convex",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.70",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.13.0",
    "@vercel/sandbox": "^3.9.1",
    "better-auth": "~1.7.22",
    "convex": "^1.49.0"
  }
}
