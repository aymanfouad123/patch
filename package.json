{
  "name": "patch",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @patch/web dev",
    "build": "pnpm --filter @patch/web build",
    "start": "pnpm --filter @patch/web start",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.0"
  }
}
