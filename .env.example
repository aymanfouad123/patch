# Written by `pnpm convex:dev` / `npx convex deployment create`
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Copy these into apps/web/.env.local for the Next.js app
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set on the Convex deployment with `npx convex env set` (server-only)
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PATCH_OWNER_GITHUB_ID=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Public repository cloned by workspaces; set on the Convex deployment
# PATCH_REPO_URL=https://github.com/aymanfouad123/patch.git

# Approved development values used only when preview mode is disabled.
# These must point to a separate development/test Convex deployment.
# PATCH_DEV_NEXT_PUBLIC_CONVEX_URL=https://<dev-deployment>.convex.cloud
# PATCH_DEV_NEXT_PUBLIC_CONVEX_SITE_URL=https://<dev-deployment>.convex.site
