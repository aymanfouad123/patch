# Written by `pnpm convex:dev` / `npx convex deployment create`
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Copy these into apps/web/.env.local for the Next.js app
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_PATCH_SERVER_URL=http://localhost:8787

# Set on the Convex deployment with `npx convex env set` (server-only)
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PATCH_OWNER_GITHUB_ID=
# PATCH_RUNNER_SECRET=

# apps/server env (local process; never put Vercel credentials on Convex)
# CONVEX_URL=
# CONVEX_SITE_URL=
# PATCH_RUNNER_SECRET=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# PORT=8787
# PATCH_WEB_ORIGIN=http://localhost:3000
# PREVIEW_TTL_MS=600000

# Approved development values used only when preview mode is disabled.
# These are resolved by apps/server from its own environment.
# PATCH_DEV_NEXT_PUBLIC_CONVEX_URL=https://<dev-deployment>.convex.cloud
# PATCH_DEV_NEXT_PUBLIC_CONVEX_SITE_URL=https://<dev-deployment>.convex.site
